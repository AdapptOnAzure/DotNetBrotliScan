<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Fail the build on any known-vulnerable package, direct or transitive. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Adappt Limited</Authors>
    <Company>Adappt Limited</Company>
    <Copyright>Copyright (c) 2026 Adappt Limited</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>brotli-scan</Product>
    <RepositoryUrl>https://github.com/AdapptOnAzure/CVE-2026-111497-DotNetBrotliScan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AdapptOnAzure/CVE-2026-111497-DotNetBrotliScan</PackageProjectUrl>
  </PropertyGroup>

  <!-- Reproducible paths and embedded commit info for builds on GitHub Actions. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
