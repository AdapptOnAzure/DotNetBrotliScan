<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin dependencies to nuget.org only: no inherited feeds, and every package mapped to one source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
